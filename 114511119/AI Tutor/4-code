## EXAMPLE 2: Functions and Bisection
#########################

def bisection_cuberoot_approx(x, epsilon):
    low = 0.0
    high = x
    guess = (high + low) / 2.0

    while abs(guess**3 - x) >= epsilon:
        if guess**3 < x:
            low = guess
        else:
            high = guess

        guess = (high + low) / 2.0

    return guess


x = 1

while x <= 10000:
    approx = bisection_cuberoot_approx(x, 0.01)
    print(approx, "is close to cube root of", x)
    x *= 10


