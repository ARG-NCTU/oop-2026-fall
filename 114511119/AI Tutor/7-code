# EXAMPLE 1: Debug Reverse List
########################################

def rev_list(L):
    """
    Input: L, a list
    Modifies L into reverse order
    Returns: nothing
    """
    for i in range(len(L) // 2):
        j = len(L) - i - 1
        temp = L[i]
        L[i] = L[j]
        L[j] = temp

L = [1, 2, 3, 4]
rev_list(L)
print(L)


########################################
# EXAMPLE 2: Debug Prime Numbers
########################################

def primes_list(n):
    """
    Input: n, an integer > 1
    Returns all prime numbers up to n
    """
    primes = [2]

    for j in range(3, n + 1):
        is_div = False

        for p in primes:
            if j % p == 0:
                is_div = True
                break

        if not is_div:
            primes.append(j)

    return primes


print(primes_list(2))
print(primes_list(15))


