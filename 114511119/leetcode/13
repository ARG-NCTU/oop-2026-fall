class KthLargest {
private:
    int k;
    vector<int> scores;
public:
    KthLargest(int k, vector<int>& nums) {
        this->k = k;
        scores = nums;
    }
    
    int add(int val) {
        scores.push_back(val);
        sort(scores.begin(), scores.end(), greater<int>());
        return scores[k - 1];
    }
};

