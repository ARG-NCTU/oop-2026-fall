/*
// Definition for Employee.
class Employee {
public:
    int id;
    int importance;
    vector<int> subordinates;
};
*/

class Solution {
private:
    vector<Employee*> mp;
public:
    int getImportance(vector<Employee*> employees, int id) {
        mp.resize(2001, nullptr);
        for(Employee* emp : employees){
            mp[emp->id] = emp;
        }
        return dfs(id);
    }
    int dfs(int id){
        Employee* emp = mp[id];
        int total = emp->importance;
        for(int sub : emp->subordinates){
            total += dfs(sub);
        }
        return total;
    }
};
