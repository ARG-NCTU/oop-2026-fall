5. Verification

My final program：

def summarize_orders(records):
    total = 0
    invalid_count = 0
    valid_count = 0

    for record in records:
        try:
            quantity = int(record)
        except ValueError:
            invalid_count += 1
            continue

        if quantity < 0:
            invalid_count += 1
        else:
            total += quantity
            valid_count += 1

    if valid_count == 0:
        raise ValueError("No valid orders")

    return total, invalid_count


