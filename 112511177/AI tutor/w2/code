def first_unique_char(s):
    counts = {}

    # 統計每個字元在整個字串中的出現次數
    for char in s:
        if char in counts:
            counts[char] += 1
        else:
            counts[char] = 1

    # 按照原字串順序尋找答案
    for i in range(len(s)):
        if counts[s[i]] == 1:
            return i

    return -1


test_cases = [
    ("aabbcdd", 4),
    ("loveleetcode", 2),
    ("aabb", -1),
    ("", -1),
    ("z", 0),
    ("zaab", 0),
    ("aabbz", 4),
    ("a" * 10000, -1),
]

for s, expected in test_cases:
    actual = first_unique_char(s)
    assert actual == expected
    label = repr(s) if len(s) <= 30 else "'a' * 10000"
    print(f"Input: {label}, Expected: {expected}, Actual: {actual}, PASS")
